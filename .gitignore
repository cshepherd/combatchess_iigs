# Build output (assembled parts, staged #TTAAAA copies). Ignore the
# contents of out/ but NOT the directory itself, so the exception below
# can re-include the built disk image as a committed release artifact.
out/*
!out/combatchess.po

# merlin32 -V listings, regenerated on every build
src/*_Output.txt

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# merlin32 side file (Cadius file-info hints)
src/_FileInformation.txt

# Atari original game images: copyrighted, keep out of the repo
reference/atari/*.atr
reference/atari/*.xex
reference/atari/*.atx
reference/atari/*.xfd
reference/atari/*.dcm
reference/atari/*.car
reference/atari/*.rom
reference/atari/*.zip

# Atari RAM dumps and input recordings hold the copyrighted game program itself
reference/raw/**/*_ram.dat
reference/raw/**/*.rec

# Captured effect audio and POKEY register dumps are derived from the
# copyrighted game program; keep them out of the repo (the generated
# src/sound_samples.s is the committed artifact, like the board art).
reference/raw/**/*.wav
reference/raw/effects/*.dat

# Standalone network bring-up harness: assembled in-place (not a Makefile
# part), so its binary lands in src/. The source (src/nettest.s) is tracked.
src/nettest
src/nettest_wrap
src/proto_test
src/netgame_test
src/nettest_client
src/netplay_test
